# 复制为 .env 后填入实际值并 chmod 600；不要提交 .env 到仓库。
F1AP_WEB_PORT=3000
F1AP_API_BASE_URL=http://api:8080
F1AP_DOCKER_NETWORK=f1ap_default
# 须与服务器后端 Nacos f1ap.internal-write-token 一致
F1AP_INTERNAL_WRITE_TOKEN=
# Cloudflare 反代域名配置（多个可用英文逗号分隔）
F1AP_ALLOWED_HOSTS=
F1AP_PUBLIC_ORIGIN=
F1AP_SERVICE_LABEL=F1AP 预测服务
